{
  "name": "MEO",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/MEO/src",
  "prefix": "ui-workspace",
  "targets": {
    "build": {
      "executor": "@angular-builders/custom-webpack:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "customWebpackConfig": {
          "path": "apps/MEO/extra-webpack.config.js",
          "mergeStrategies": {
            "externals": "replace"
          }
        },
        "outputPath": "dist/apps/MEO",
        "index": "apps/MEO/src/index.html",
        "main": "apps/MEO/src/main.ts",
        "polyfills": "apps/MEO/src/polyfills.ts",
        "tsConfig": "apps/MEO/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/MEO/src/favicon.ico", "apps/MEO/src/assets",
         {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/"
              }
        ],
        "styles": [
          "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
          "node_modules/intl-tel-input/build/css/intlTelInput.css",
          "node_modules/ngx-toastr/toastr.css",
          "apps/MEO/src/styles.scss"
        ],
        "scripts": ["node_modules/intl-tel-input/build/js/intlTelInput.min.js"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "20mb",
              "maximumError": "20mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20mb",
              "maximumError": "20mb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "apps/MEO/src/environments/environment.ts",
              "with": "apps/MEO/src/environments/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "local": {
          "fileReplacements": [
            {
              "replace": "apps/MEO/src/environments/environment.ts",
              "with": "apps/MEO/src/environments/environment.local.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "fileReplacements": [
            {
              "replace": "apps/MEO/src/environments/environment.ts",
              "with": "apps/MEO/src/environments/environment.local.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "browserTarget": "MEO:build:production"
        },
        "development": {
          "browserTarget": "MEO:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "MEO:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["apps/MEO/**/*.ts", "apps/MEO/**/*.html"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/MEO/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}
